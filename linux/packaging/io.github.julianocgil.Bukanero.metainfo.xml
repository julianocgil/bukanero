<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.julianocgil.Bukanero</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Bukanero</name>
  <summary>Privacy-first IPTV player</summary>
  <summary xml:lang="pt_BR">Player de IPTV com privacidade</summary>
  <summary xml:lang="es">Reproductor IPTV con privacidad</summary>
  <summary xml:lang="fr">Lecteur IPTV respectueux de la vie privée</summary>
  <summary xml:lang="de">IPTV-Player mit Fokus auf Privatsphäre</summary>
  <summary xml:lang="it">Lettore IPTV rispettoso della privacy</summary>

  <developer id="io.github.julianocgil">
    <name>Juliano Gil</name>
  </developer>

  <description>
    <p>
      Bukanero plays the live channels, movies and series of the M3U playlists
      you add, with a TV guide and a clean, fast interface.
    </p>
    <p>
      Bukanero does not include, sell or recommend any content: it only plays
      playlists and guides that you provide. It has no telemetry and no
      accounts, and only talks to the server of your own playlist.
    </p>
    <p>Features:</p>
    <ul>
      <li>Live channels, movies and series from M3U playlists, including Xtream-style servers</li>
      <li>TV guide (XMLTV) with what is on now and a full timeline</li>
      <li>Smart grouping: the HD, FHD, 4K, dubbed and subtitled versions of the same channel or movie become a single card</li>
      <li>A frozen live channel reconnects by itself and, if needed, switches to another version</li>
      <li>Favorites, hidden items, continue watching, ratings and synopses when the server provides them</li>
      <li>Seasons and episodes, with a next-episode countdown</li>
      <li>Several profiles, dark, black and light themes, and accent colors</li>
      <li>Hardware-accelerated video powered by mpv</li>
      <li>Available in English, Portuguese, Spanish, French, German and Italian</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.julianocgil.Bukanero.desktop</launchable>

